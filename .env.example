# COUCHFLIX — copia este fichero:  cp .env.example .env   y rellena lo que necesites.
# Todas las variables son opcionales: también pueden configurarse desde Ajustes en la interfaz.

# --- Catálogo (necesario para datos reales) ---------------------------------
# API key (v3) o token (v4) de https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# --- Agente LLM (opcional; sin él se usa el motor de reglas) -----------------
# none | anthropic | openai   (openai = cualquier API compatible: OpenAI, Ollama, LM Studio…)
COUCHFLIX_LLM=none

# Si COUCHFLIX_LLM=anthropic
ANTHROPIC_API_KEY=

# Si COUCHFLIX_LLM=openai
OPENAI_API_KEY=
# Solo si no usas api.openai.com, p. ej. Ollama: http://localhost:11434/v1
OPENAI_BASE_URL=
# El modelo se elige en Ajustes (por defecto gpt-4o-mini / claude-haiku-5-5)

# --- Servidor y datos (valores por defecto) ----------------------------------
# COUCHFLIX_HOST=127.0.0.1
# COUCHFLIX_PORT=8765
# COUCHFLIX_DB=data/couchflix.db
# COUCHFLIX_PROVIDERS=tmdb
